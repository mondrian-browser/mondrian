{
  "name": "mondrian",
  "version": "0.1.0",
  "description": "A browser that renders no page as sent. Every document is pulled apart into blocks and laid back out in one layout language. Electron shell, localhost control server, MCP bridge, hot-reloadable site rules and UI.",
  "private": true,
  "main": "app/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "mcp": "node tools/mcp/server.js",
    "test": "node tests/e2e.js",
    "install-mcp": "node tools/install-mcp.js",
    "test:sites": "node tests/site-suite.js",
    "test:agent": "node tests/agent-suite.js",
    "test:all": "node tests/e2e.js && node tests/site-suite.js && node tests/agent-suite.js",
    "docs": "node tools/gen-docs.js",
    "label:trial": "node tools/label/trial.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tldts-experimental": "^7.4.9",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  },
  "license": "Apache-2.0",
  "author": "Lloyd Collidge",
  "repository": {
    "type": "git",
    "url": "https://github.com/mondrian-browser/mondrian.git"
  },
  "bugs": {
    "url": "https://github.com/mondrian-browser/mondrian/issues"
  }
}
