  },
  {
   "index": 34,
   "tag": "p",
   "landmarks": [
    "section",
    "section",
    "main",
    "article"
   ],
   "textLength": 436,
   "text": "The Cross device SDK is a software abstraction layer that enables both\nplatform-driven and developer-driven multidevice experiences by leveraging\nvarious wireless technologies such as Bluetooth, Wi-Fi, and ultra-wideband. This\nabstraction allows developers to focus on the most important parts of the user\nexperience while the SDK handles underlying aspects of platform capabilities,\ndevice discovery",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
