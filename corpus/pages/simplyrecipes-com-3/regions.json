    "aboveFold": false
   }
  },
  {
   "index": 13,
   "tag": "p",
   "id": "mntl-sc-block_12-0",
   "class": "comp mntl-sc-block mntl-sc-block-html",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 289,
   "text": "General Tso’s chicken involves deep-frying, but with a little prep and pluck it comes together without a hitch. Just take it step by step, set out all your ingredients before you start, and stick to your station once you get going. All told, the frying process only takes about 15 minutes.",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0.04,
   "geometry": {
