   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 154,
   "text": "Many recipes for General Tso’s chicken involve a marination step, but because the sauce here is so flavorful, we skip marination to streamline the recipe.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
