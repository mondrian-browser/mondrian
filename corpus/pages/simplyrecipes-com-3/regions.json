   "id": "mntl-sc-block_6-0",
   "class": "comp mntl-sc-block mntl-sc-block-html",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 182,
   "text": "Takeout will always be there on those “I can’t even” nights, but be warned: after making this superlative General Tso’s, you may have to pivot to another menu item when you order in.",
