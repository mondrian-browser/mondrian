  },
  {
   "index": 27,
   "tag": "blockquote",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 111,
   "text": "The trick with qualitative evidence is collecting it rigorously enough that nobody can wave it off as anecdote.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
