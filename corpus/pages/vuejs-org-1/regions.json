    "aboveFold": false
   }
  },
  {
   "index": 22,
   "tag": "ul",
   "landmarks": [
    "main"
   ],
   "textLength": 248,
   "text": "Enhancing static HTML without a build step\nEmbedding as Web Components on any page\nSingle-Page Application (SPA)\nFullstack / Server-Side Rendering (SSR)\nJamstack / Static Site Generation (SSG)\nTargeting desktop, mobile, WebGL, and even the terminal",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 6,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
