   "landmarks": [
    "main"
   ],
   "textLength": 60,
   "text": "The above example demonstrates the two core features of Vue:",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
