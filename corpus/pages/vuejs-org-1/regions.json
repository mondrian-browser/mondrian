   }
  },
  {
   "index": 17,
   "tag": "ul",
   "landmarks": [
    "main"
   ],
   "textLength": 266,
   "text": "Declarative Rendering: Vue extends standard HTML with a template syntax that allows us to declaratively describe HTML output based on JavaScript state.\nReactivity: Vue automatically tracks JavaScript state changes and efficiently updates the DOM when changes happen.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 2,
    "tableRows": 0,
