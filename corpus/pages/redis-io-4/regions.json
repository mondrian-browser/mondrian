   "landmarks": [
    "main",
    "section"
   ],
   "textLength": 142,
   "text": "Store LLM responses for AI apps in a semantic cache.\nLangCache is currently available in preview. Features and behavior are subject to change.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 2,
