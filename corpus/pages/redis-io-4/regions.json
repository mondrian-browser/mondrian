  },
  {
   "index": 8,
   "tag": "p×2",
   "landmarks": [
    "main",
    "section"
   ],
   "textLength": 302,
   "text": "Cut LLM costs and improve response times with semantic caching.\nLangCache checks whether a semantically similar prompt has been answered before and returns the cached response instantly — no LLM call required. When there's no match, your app calls the LLM as usual and stores the result for future use.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
