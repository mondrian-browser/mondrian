   }
  },
  {
   "index": 26,
   "tag": "p",
   "landmarks": [
    "main",
    "section"
   ],
   "textLength": 114,
   "text": "The more requests you serve from LangCache, the more you save, because you’re not paying to regenerate the output.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 3855,
    "height": 48,
    "widthFraction": 0.43,
    "leftFraction": 0.33,
    "pageFraction": 0.6,
    "aboveFold": false
   }
  },
  {
   "index": 27,
   "tag": "ul",
   "landmarks": [
    "main",
    "section"
   ],
   "textLength": 192,
   "text": "Here’s an example:\nMonthly LLM spend: $200\nPercentage of output tokens in your spend: 60%\nCost of output tokens: $200 × 60% = $120\nCache hit rate: 50%\nEstimated savings: $120 × 50% = $60/month",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 5,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
