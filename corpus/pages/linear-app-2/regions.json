  {
   "index": 13,
   "tag": "p×2",
   "landmarks": [
    "main"
   ],
   "textLength": 293,
   "text": "Loops run at the team and workspace level, with shared visibility and control. Anyone with access can review their instructions, see how they are configured, and inspect what happened during each run.\nThis makes Loops well suited to shared workflows that need to happen consistently over time.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 2,
