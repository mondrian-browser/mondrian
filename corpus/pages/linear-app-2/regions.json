    "aboveFold": false
   }
  },
  {
   "index": 6,
   "tag": "ul",
   "landmarks": [
    "main"
   ],
   "textLength": 223,
   "text": "an engineer needs to understand every incoming bug report and investigate\na project manager needs to notify teams affected by scope changes as they happen\na marketer needs to update the launch schedule as target dates shift",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 3,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 1235,
