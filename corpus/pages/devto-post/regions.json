    "aboveFold": false
   }
  },
  {
   "index": 10,
   "tag": "pre",
   "class": "highlight typescript",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 151,
   "text": "return match(err, {\n NotFound: (e) => respond(404, e.id),\n Forbidden: (e) => respond(403, e.reason),\n DbError: (e) => respond(503, e.cause.message),\n})",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
