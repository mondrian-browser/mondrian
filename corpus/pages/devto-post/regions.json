    "main",
    "article"
   ],
   "textLength": 324,
   "text": "I write mostly TypeScript and some Go. When I switch back from Go, I miss explicit error returns. A function that can fail says so, and I deal with it right there.\nIn TypeScript I get catch (e), where e is unknown, thrown from some layer I forgot could throw.\nI wrote errval: zero dependencies, 1.86 kB minified and gzipped.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 3,
    "repeats": 3,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 780,
    "height": 190,
    "widthFraction": 0.52,
    "leftFraction": 0.13,
    "pageFraction": 0.21,
    "aboveFold": true
   }
  },
  {
   "index": 8,
   "tag": "pre",
   "class": "highlight typescript",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 108,
   "text": "const [err, user] = await getUser(id)\nif (err) return fail(err)\nuser.email // narrowed. no undefined, no `!`",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
