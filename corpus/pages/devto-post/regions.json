   "textLength": 78,
   "text": "neverthrow: 198 ns\nerrval: 226 ns\ntry/catch: 2,623 ns\nEffect runSync: 3,952 ns",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 4,
