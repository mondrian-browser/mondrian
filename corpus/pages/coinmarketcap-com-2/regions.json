   "class": "sc-fa539dd8-3 bGsoaN text-content",
   "landmarks": [
    "aside",
    "main"
   ],
   "textLength": 25,
   "text": "That distinction matters.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
