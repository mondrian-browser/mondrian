   "landmarks": [
    "aside",
    "main"
   ],
   "textLength": 187,
   "text": "The supply is another important detail. Around 990 trillion tokens are circulating against a maximum supply of roughly 1 quadrillion, so this is not a story about a large upcoming unlock.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
