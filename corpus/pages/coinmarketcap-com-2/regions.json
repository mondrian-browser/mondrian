   "class": "sc-fa539dd8-3 bGsoaN text-content",
   "landmarks": [
    "aside",
    "main"
   ],
   "textLength": 83,
   "text": "And there is no clear 2026 catalyst in the research that explains a major new move.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
