   ],
   "textLength": 602,
   "text": "The innerText property of the HTMLElement interface represents the rendered text content of a node and its descendants.\nAs a getter, it approximates the text the user would get if they highlighted the contents of the element with the cursor and then copied it to the clipboard.\nAs a setter this will replace the element's children with the given value, converting any line breaks into <br> elements.\n",
   "counts": {
    "links": 3,
    "images": 0,
    "headings": 0,
