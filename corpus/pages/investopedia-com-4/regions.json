    "leftFraction": 0.26,
    "pageFraction": 0.25,
    "aboveFold": false
   }
  },
  {
   "index": 14,
   "tag": "div",
   "id": "mntl-sc-block_10-0",
   "class": "comp mntl-sc-block finance-sc-block-callout mntl-sc-block-universal-callout",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 397,
   "text": "Warning\nMortgage lending discrimination is illegal. If you think you’ve been discriminated against based on race, religion, sex, marital status, use of public assistance, national origin, disability, or age, there are steps you can take. One such step is to file a report with the Consumer Financial Protection Bureau (CFPB) or the United States Department of Housing and Urban Development (HUD).2",
   "counts": {
    "links": 3,
    "images": 1,
    "headings": 1,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
