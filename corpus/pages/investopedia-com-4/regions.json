    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 3153,
    "height": 35,
    "widthFraction": 0.41,
    "leftFraction": 0.26,
    "pageFraction": 0.33,
    "aboveFold": false
   }
  },
  {
   "index": 18,
   "tag": "p",
   "id": "mntl-sc-block_16-0",
   "class": "comp mntl-sc-block finance-sc-block-html mntl-sc-block-html",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 356,
   "text": "Pre-approval typically requires completing a mortgage application and the lender doing a hard inquiry to determine creditworthiness. With that information, the lender can give a more accurate estimate of what the borrower will be approved for once they’re ready to complete a mortgage application. This offer is usually good for a period of up to 60 days.3",
   "counts": {
    "links": 2,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0.07,
   "geometry": {
    "top": 3196,
    "height": 137,
    "widthFraction": 0.41,
    "leftFraction": 0.26,
    "pageFraction": 0.33,
    "aboveFold": false
   }
  },
  {
   "index": 19,
   "tag": "div",
   "id": "mntl-sc-block_18-0",
   "class": "comp mntl-sc-block finance-sc-block-callout mntl-sc-block-universal-callout",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 183,
   "text": "Important\nA pre-approval doesn’t guarantee the final loan amount, as the lender may learn new information during the full underwriting process that changes what it’s willing to offer.",
   "counts": {
    "links": 0,
    "images": 1,
    "headings": 1,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
