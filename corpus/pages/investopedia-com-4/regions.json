   "textLength": 26,
   "text": "Understanding Pre-Approval",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 1,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
