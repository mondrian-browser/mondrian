   "tag": "ul",
   "landmarks": [
    "main"
   ],
   "textLength": 180,
   "text": "Opening a joint account can have benefits:\nIt's easier to pay for shared costs from one account\nYou'll potentially have fewer bank fees to pay\nAll account holders oversee the money",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 3,
    "tableRows": 0,
    "controls": 0,
