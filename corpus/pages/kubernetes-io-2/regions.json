    "widthFraction": 0.46,
    "leftFraction": 0.22,
    "pageFraction": 0.71,
    "aboveFold": false
   }
  },
  {
   "index": 45,
   "tag": "div",
   "class": "alert alert-info",
   "role": "note",
   "landmarks": [
    "main"
   ],
   "textLength": 161,
   "text": "Note:\nIn releases older than Debian 12 and Ubuntu 22.04, directory /etc/apt/keyrings does not\nexist by default, and it should be created before the curl command.",
   "counts": {
    "links": 0,
    "images": 0,
