   }
  },
  {
   "index": 20,
   "tag": "ul",
   "landmarks": [
    "main"
   ],
   "textLength": 187,
   "text": "You can get the MAC address of the network interfaces using the command ip link or ifconfig -a\nThe product_uuid can be checked by using the command sudo cat /sys/class/dmi/id/product_uuid",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 2,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 2131,
    "height": 100,
    "widthFraction": 0.49,
    "leftFraction": 0.2,
