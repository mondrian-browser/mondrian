   "textLength": 177,
   "text": "The kubeadm project supports LTS kernels. See List of LTS kernels.\nYou can get the kernel version using the command uname -r\nFor more information, see Linux Kernel Requirements.",
   "counts": {
    "links": 2,
    "images": 0,
    "headings": 0,
    "listItems": 2,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
