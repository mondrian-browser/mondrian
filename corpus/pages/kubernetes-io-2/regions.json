    "height": 200,
    "widthFraction": 0.49,
    "leftFraction": 0.2,
    "pageFraction": 0.65,
    "aboveFold": false
   }
  },
  {
   "index": 42,
   "tag": "div",
   "class": "alert alert-info",
   "role": "note",
   "landmarks": [
    "main"
   ],
   "textLength": 202,
   "text": "Note:\nThere's a dedicated package repository for each Kubernetes minor version. If you want to install\na minor version other than v1.37, please see the installation guide for\nyour desired minor version.",
   "counts": {
