  {
   "index": 44,
   "tag": "ol",
   "landmarks": [
    "main"
   ],
   "textLength": 774,
   "text": "These instructions are for Kubernetes v1.37.\nUpdate the apt package index and install packages needed to use the Kubernetes apt repository:\nsudo apt-get update\n# apt-transport-https may be a dummy package; if so, you can skip that package\nsudo apt-get install -y apt-transport-https ca-certificates curl gpg\nDownload the public signing key for the Kubernetes package repositories.\nThe same signing ke",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 2,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 3,
