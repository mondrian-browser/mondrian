   ],
   "textLength": 19,
   "text": "Being a teenage mum",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 1,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 5329,
    "height": 42,
    "widthFraction": 0.47,
    "leftFraction": 0.28,
    "pageFraction": 0.55,
    "aboveFold": false
   }
  },
  {
   "index": 24,
   "tag": "p×3",
   "class": "bodyParagaph",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 399,
   "text": "Being a mum at 17 was not how I expected my story to go. I felt very alone when I was pregnant and realised how much my life was changing.\nAll my friends had a freedom I knew I wouldn't have anymore, and I felt the weight of responsibility like a backpack I carried everywhere.\nBut alongside those feelings was an immense love for my son Ethan and a real hope that I could give him a beautiful life.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 3,
    "repeats": 3,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
