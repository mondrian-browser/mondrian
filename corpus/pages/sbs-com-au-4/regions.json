   "class": "EmbeddedRelatedContent-module__e1apoG__container",
   "landmarks": [
    "main",
    "article",
    "aside"
   ],
   "textLength": 96,
   "text": "READ MORE\nJulie-Anne is overwhelmed caring for her mum. She won't expect her kids to do the same",
   "counts": {
    "links": 1,
    "images": 1,
    "headings": 1,
    "listItems": 1,
    "tableRows": 0,
    "controls": 0,
