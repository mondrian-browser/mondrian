   "class": "EmbedImage-module__sWEj_G__figureContainer",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 65,
   "text": "Esther and Matt in their early days as a couple. Source: Supplied",
   "counts": {
    "links": 0,
    "images": 1,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
