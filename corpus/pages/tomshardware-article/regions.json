  {
   "index": 23,
   "tag": "p",
   "class": "kiosq-b",
   "landmarks": [
    "role=main",
    "article",
    "section"
   ],
   "textLength": 518,
   "text": "The XV273U F5 also provides excellent image quality from an IPS panel, which has far higher contrast than its claimed 1,000:1 ratio. I measured just over 2,000:1 in testing, which blows away most other IPS panels for dynamic range. The black levels are almost in VA territory, resulting in a very deep, textural image. Acer gets color and gamma right as well, and with a few tweaks that I’ll show you",
   "counts": {
    "links": 2,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
