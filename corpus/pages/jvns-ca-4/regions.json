    "height": 112,
    "widthFraction": 0.4,
    "leftFraction": 0.3,
    "pageFraction": 0.85,
    "aboveFold": false
   }
  },
  {
   "index": 61,
   "tag": "blockquote",
   "landmarks": [
    "article",
    "main"
   ],
   "textLength": 213,
   "text": "They’ve heard it’s simple, so they assume it’s easy. But then when they try to\nuse it, it doesn’t work. It must be the fault of the language, because they know\nthat they are smart, and this is supposed to be easy.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
