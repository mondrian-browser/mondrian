   ],
   "textLength": 223,
   "text": "This next part is the bulk of the CSS!\nThe idea here is to organize CSS by “components”, in a way that’s spiritually\nrelated to Vue or React components. (though there might not actually be any Javascript at all in the site)",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 2,
