   "landmarks": [
    "section",
    "section",
    "main",
    "article"
   ],
   "textLength": 1502,
   "text": "Alexandra: I was really drawn to\npleasefunda11y.com. It's really important to get\ndevelopers to learn how to build accessible sites, but they won't always have\nthe resources without having executive leadership funding and approval. Why did\nyou decide to build this site?\nMelanie: I was frustrated because accessibility is so underfunded. All of\nthe open source funding seems to keep going to CSS. And",
   "counts": {
    "links": 2,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 6,
