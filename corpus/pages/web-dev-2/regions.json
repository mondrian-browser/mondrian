   "landmarks": [
    "section",
    "section",
    "main",
    "article"
   ],
   "textLength": 318,
   "text": "Alexandra: (laughs) Oh no.\nMelanie: His boss was always complaining that he could never see my work! I\nhad to develop a set of complementary colors and a color scheme for our sites.\nThat got me thinking about color contrast and thinking about how people who are\ncolorblind (or otherwise visually impaired) use the web.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
