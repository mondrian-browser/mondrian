   "landmarks": [
    "section",
    "section",
    "main",
    "article"
   ],
   "textLength": 174,
   "text": "Because UNC is a state university, there's a\nUS federal requirement\nto conform with WCAG accessibility level AA. We aimed for level AAA because\nit's an education institution.",
   "counts": {
