   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 70,
   "text": "Each Electron release provides binaries for macOS, Windows, and Linux.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
