    "aboveFold": false
   }
  },
  {
   "index": 16,
   "tag": "ul",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 490,
   "text": "macOS (Ventura and up): Electron provides 64-bit Intel and Apple Silicon / ARM binaries for macOS.\nWindows (Windows 10 and up): Electron provides x64 (amd64) and arm64 binaries for Windows.\nLinux: Electron provides x64 (amd64) and arm64 binaries for Linux. Electron supports major Linux distributions (e.g., Ubuntu, Fedora, Debian) in versions that are still supported by both Chromium and the distro",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 3,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
    "repeats": 1
