   "textLength": 232,
   "text": "The tiny needle on your record player — sometimes called a stylus — has an outsized impact on sound quality. As the only point of contact between your turntable and your records, it directly affects playback clarity and record wear.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
