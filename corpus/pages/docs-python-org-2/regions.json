   "landmarks": [
    "role=main",
    "section",
    "section"
   ],
   "textLength": 902,
   "text": "pip is the preferred installer program. It\nis included by default with the Python binary installers.\nA virtual environment is a semi-isolated Python environment that allows\npackages to be installed for use by a particular application, rather than\nbeing installed system wide.\nvenv is the standard tool for creating virtual environments.\nIt defaults to installing pip into all created virtual environm",
   "counts": {
    "links": 3,
    "images": 0,
    "headings": 0,
    "listItems": 6,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 6,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0.07,
   "geometry": {
