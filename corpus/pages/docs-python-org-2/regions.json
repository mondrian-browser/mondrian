   ],
   "textLength": 625,
   "text": "As a popular open source development project, Python has an active\nsupporting community of contributors and users that also make their software\navailable for other Python developers to use under open-source license terms.\nThis allows Python users to share and collaborate effectively, benefiting\nfrom the solutions others have already created to common (and sometimes\neven rare!) problems, as well as",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 3,
    "repeats": 3,
    "coverLinks": 0
   },
   "linkTextRatio": 0.04,
   "geometry": {
    "top": 148,
