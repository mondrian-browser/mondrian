   }
  },
  {
   "index": 13,
   "tag": "p",
   "landmarks": [
    "role=main",
    "section",
    "section"
   ],
   "textLength": 161,
   "text": "Normally, if a suitable module is already installed, attempting to install\nit again will have no effect. Upgrading existing modules must be requested\nexplicitly:",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0,
   "geometry": {
    "top": 1467,
    "height": 51,
    "widthFraction": 0.56,
    "leftFraction": 0.27,
    "pageFraction": 0.41,
    "aboveFold": false
   }
  },
  {
   "index": 14,
   "tag": "p",
   "landmarks": [
    "role=main",
    "section",
    "section"
   ],
   "textLength": 158,
   "text": "python -m pip install --upgrade SomePackage\nMore information and resources regarding pip and its capabilities can be\nfound in the Python Packaging User Guide.",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
