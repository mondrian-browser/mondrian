    "aboveFold": true
   }
  },
  {
   "index": 3,
   "tag": "div",
   "class": "admonition note",
   "landmarks": [
    "role=main",
    "section"
   ],
   "textLength": 281,
   "text": "Note\nFor corporate and other institutional users, be aware that many\norganisations have their own policies around using and contributing to\nopen source software. Please take such policies into account when making\nuse of the distribution and installation tools provided with Python.",
   "counts": {
    "links": 0,
