  {
   "index": 15,
   "tag": "p",
   "landmarks": [
    "role=main",
    "section",
    "section"
   ],
   "textLength": 151,
   "text": "Creation of virtual environments is done through the venv module.\nInstalling packages into an active virtual environment uses the commands shown\nabove.",
