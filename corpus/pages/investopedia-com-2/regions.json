   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 224,
   "text": "It is frustrating when an employer will not verify employment, but it can be easy to fix this situation in some cases. The first thing to do is tell your employer’s human resources (HR) department that you need verification.",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
