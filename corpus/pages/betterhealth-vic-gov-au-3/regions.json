   "landmarks": [
    "main",
    "section"
   ],
   "textLength": 75,
   "text": "‘Perimenopause’ is the time leading up to menopause.\nWhat causes menopause?",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 1,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
