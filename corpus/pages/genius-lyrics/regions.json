  },
  {
   "index": 27,
   "tag": "blockquote",
   "landmarks": [
    "main"
   ],
   "textLength": 94,
   "text": "This here ain’t no protest song or anything like that, ‘cause I don’t write no protest songs’…",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
