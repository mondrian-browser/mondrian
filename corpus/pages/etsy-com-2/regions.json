   "tag": "ol",
   "landmarks": [
    "main",
    "article",
    "section"
   ],
   "textLength": 193,
   "text": "To update your region:\nSign in to Etsy.com and go to Your account.\nChoose Account settings.\nIn the Account tab, go to Region.  \nSelect your location in the dropdown menu. \nChoose Save settings.",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 0,
