   "textLength": 200,
   "text": "Your region preference is used on certain parts of Etsy to show you relevant items while you shop. For example, it’s used to automatically show items that are delivered to you when you search on Etsy.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
