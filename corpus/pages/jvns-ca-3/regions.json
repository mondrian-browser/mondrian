  {
   "index": 7,
   "tag": "h3",
   "id": "cleaning-up-the-database-is-tricky",
   "class": "post-heading",
   "landmarks": [
    "article",
    "main"
   ],
   "textLength": 81,
   "text": "Maybe one day I’ll learn to read a query plan.\ncleaning up the database is tricky",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 1,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
