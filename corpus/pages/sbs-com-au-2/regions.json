   }
  },
  {
   "index": 13,
   "tag": "p×2",
   "class": "bodyParagaph",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 414,
   "text": "Understanding and valuing Aboriginal and Torres Strait Islander heritage and contemporary experiences is key to reconciliation, the process towards strengthening relationships between Australia’s First Nations and non-Indigenous peoples.\nThat’s why supporting your child’s connection with the world’s oldest continuing living culture is one of the greatest gifts you can offer them while raising them",
   "counts": {
