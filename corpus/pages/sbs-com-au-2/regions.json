  },
  {
   "index": 12,
   "tag": "ul",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 321,
   "text": "How can I introduce my child to Indigenous culture and history?\nHow do I find events celebrating Aboriginal and Torres Strait Islander culture?\nIs there educational content on Indigenous Australia for children online?\nHow can we get to know First Nations culture during a family trip?\nWhat if I say or do something wrong?",
   "counts": {
    "links": 5,
    "images": 0,
    "headings": 0,
    "listItems": 5,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 0,
    "repeats": 1,
    "coverLinks": 0
   },
   "linkTextRatio": 0.99,
   "geometry": {
    "top": 2063,
    "height": 135,
