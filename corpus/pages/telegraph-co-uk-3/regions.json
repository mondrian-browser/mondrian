    "aboveFold": false
   }
  },
  {
   "index": 8,
   "tag": "p",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 191,
   "text": "Then it disappeared.\nTwo days later, according to reports, it reappeared on maritime trackers as its transponder was apparently turned back on, near Fujairah, on the other side of the strait.",
   "counts": {
    "links": 0,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 2,
