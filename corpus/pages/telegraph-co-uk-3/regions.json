   "index": 7,
   "tag": "p",
   "landmarks": [
    "main",
    "article"
   ],
   "textLength": 267,
   "text": "The Singapore Prosperity had docked at a series of Saudi ports in mid-August as it made its way through the Gulf. The tanker, roughly the size of three football pitches, was carrying an estimated two million barrels of crude oil as it headed for the Strait of Hormuz.",
   "counts": {
    "links": 1,
    "images": 0,
    "headings": 0,
    "listItems": 0,
    "tableRows": 0,
    "controls": 0,
    "paragraphs": 1,
