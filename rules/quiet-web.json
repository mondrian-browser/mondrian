{
  "title": "Quiet web",
  "enabled": true,
  "note": "Cross-site ad and tracking noise. Add hosts as you meet them.",
  "match": [
    "<all_urls>"
  ],
  "block": [
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.google-analytics.com/*",
    "*://*.scorecardsresearch.com/*",
    "*://*.taboola.com/*",
    "*://*.outbrain.com/*"
  ],
  "css": "",
  "js": ""
}
